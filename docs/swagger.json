{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "hw7-swagger",
    "description": "API для керування контактами та аутентифікації користувачів. Підтримує JWT-авторизацію, реєстрацію, логін, скидання пароля."
  },
  "servers": [
    {
      "url": "https://nodejs-hw-mongodb-4t6o.onrender.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Користувачі: реєстрація, логін, скидання пароля"
    }
  ],
  "paths": {
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Реєстрація користувача",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserInputWithName"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Користувач успішно зареєстрований",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Successfully registered a user!" },
                    "data": { "$ref": "#/components/schemas/User" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некоректні дані"
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Логін користувача",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Успішний логін",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Successfully logged in an user!" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": { "type": "string", "example": "jwt-token" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Невірний email або пароль"
          }
        }
      }
    },
    "/auth/send-reset-email": {
      "post": {
        "tags": ["Auth"],
        "summary": "Надіслати лист для скидання пароля",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": { "type": "string", "example": "lupin773311asd@gmail.com" }
                },
                "required": ["email"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Лист надіслано",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "Reset password email has been successfully sent." },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некоректні дані"
          }
        }
      }
    },
    "/auth/reset-pwd": {
      "post": {
        "tags": ["Auth"],
        "summary": "Скинути пароль за токеном",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": { "type": "string", "example": "eyJhbGc..." },
                  "password": { "type": "string", "example": "MySuperNewPassword2024" }
                },
                "required": ["token", "password"]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Пароль успішно скинуто",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "integer", "example": 200 },
                    "message": { "type": "string", "example": "Password has been successfully reset." },
                    "data": { "type": "object" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Некоректні дані або токен"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UserInputWithName": {
        "type": "object",
        "required": ["name", "email", "password"],
        "properties": {
          "name": { "type": "string", "example": "Mila Roza" },
          "email": { "type": "string", "example": "lupin773311asd@gmail.com" },
          "password": { "type": "string", "example": "secretPassword" }
        }
      },
      "UserInput": {
        "type": "object",
        "required": ["email", "password"],
        "properties": {
          "email": { "type": "string", "example": "lupin773311asd@gmail.com" },
          "password": { "type": "string", "example": "secretPassword" }
        }
      },
      "User": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Mila Roza" },
          "email": { "type": "string", "example": "lupin773311asd@gmail.com" },
          "_id": { "type": "string", "example": "6873c31845f66eef24a182ae" },
          "createdAt": { "type": "string", "example": "2025-07-13T14:30:48.740Z" },
          "updatedAt": { "type": "string", "example": "2025-07-13T14:30:48.740Z" },
          "__v": { "type": "integer", "example": 0 }
        }
      }
    }
  }
}


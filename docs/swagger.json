{
  "openapi": "3.1.0",
  "info": {
    "version": "1.0.0",
    "title": "hw7-swagger",
    "license": {
      "name": "Apache 2.0",
      "url": "http://www.apache.org/licenses/LICENSE-2.0.html"
    },
    "description": "This API provides CRUD operations for managing contacts and supports user registration and login. \nUsers can create, view, update, and delete their contacts after authentication. The API uses JWT for authentication.\n"
  },
  "servers": [
    {
      "url": "http://localhost:300",
      "description": "Local development server"
    },
    {
      "url": "https://nodejs-hw-mongodb-4t6o.onrender.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Contacts",
      "description": "Operations related to contacts management"
    },
    {
      "name": "Auth",
      "description": "User registration and authentication"
    }
  ],
  "paths": {
    "/contacts": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get all contacts",
        "operationId": "getContacts",
        "description": "Returns a list of all contacts. Supports pagination, sorting, and filtering.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "name": "page", "in": "query", "required": false, "description": "Page number", "schema": { "type": "integer", "default": 1 }},
          { "name": "perPage", "in": "query", "required": false, "description": "Number of contacts per page", "schema": { "type": "integer", "default": 10 }},
          { "name": "sortBy", "in": "query", "required": false, "description": "Sort field", "schema": { "type": "string", "default": "name" }},
          { "name": "sortOrder", "in": "query", "required": false, "description": "Sort order (asc or desc)", "schema": { "type": "string", "default": "asc", "enum": ["asc", "desc"] }},
          { "name": "type", "in": "query", "required": false, "description": "Filter by contactType", "schema": { "type": "string" }},
          { "name": "isFavourite", "in": "query", "required": false, "description": "Filter by favourite contacts (true/false)", "schema": { "type": "boolean" }}
        ],
        "responses": {
          "200": {
            "description": "List of contacts with pagination",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Successfully found contacts!" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "data": { "type": "array", "items": { "$ref": "#/components/schemas/Contact" }},
                        "page": { "type": "integer", "example": 1 },
                        "perPage": { "type": "integer", "example": 10 },
                        "totalItems": { "type": "integer", "example": 17 },
                        "totalPages": { "type": "integer", "example": 2 },
                        "hasPreviousPage": { "type": "boolean", "example": false },
                        "hasNextPage": { "type": "boolean", "example": true }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Not authorized" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Contacts"],
        "summary": "Create a new contact",
        "operationId": "createContact",
        "description": "Creates a new contact",
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ContactInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Contact created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "code": { "type": "integer", "example": 201 },
                    "data": { "$ref": "#/components/schemas/Contact" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Missing required fields: name, phoneNumber, contactType" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/contacts/{contactId}": {
      "get": {
        "tags": ["Contacts"],
        "summary": "Get contact by ID",
        "operationId": "getContactById",
        "description": "Returns a contact by its unique ID.",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Unique ID of the contact",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "200": {
            "description": "Contact found successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "code": { "type": "integer", "example": 200 },
                    "data": {
                      "type": "object",
                      "properties": {
                        "_id": { "type": "string", "example": "6873b7b1957d23253b9e6537" },
                        "name": { "type": "string", "example": "Anna Smith" },
                        "phoneNumber": { "type": "string", "example": "+380991112233" },
                        "email": { "type": "string", "example": "anna.smith@work.com" },
                        "isFavourite": { "type": "boolean", "example": false },
                        "contactType": { "type": "string", "example": "work" },
                        "userId": { "type": "string", "example": "6873aebc8c71dc460b5d365e" },
                        "photo": { "type": ["string", "null"], "example": null },
                        "createdAt": { "type": "string", "example": "2025-07-13T13:42:09.531Z" },
                        "updatedAt": { "type": "string", "example": "2025-07-13T13:42:09.531Z" }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Contact not found" }
                  }
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": ["Contacts"],
        "summary": "Update a contact by ID",
        "operationId": "updateContactById",
        "description": "Updates the contact by its unique ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Unique ID of the contact",
            "schema": { "type": "string" }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ContactInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Contact updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Contact with id 68725a5e1785c8943512c751 updated successfully!" },
                    "data": { "$ref": "#/components/schemas/Contact" }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "No data provided for update" }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Contact not found" }
                  }
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": ["Contacts"],
        "summary": "Delete a contact by ID",
        "operationId": "deleteContactById",
        "description": "Deletes the contact by its unique ID",
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          {
            "name": "contactId",
            "in": "path",
            "required": true,
            "description": "Unique ID of the contact",
            "schema": { "type": "string" }
          }
        ],
        "responses": {
          "204": { "description": "Contact deleted successfully" },
          "404": {
            "description": "Contact not found",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Contact not found" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register new user",
        "operationId": "registerUser",
        "description": "Register a new user with name, email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInputWithName" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User registered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Successfully registered a user!" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "name": { "type": "string", "example": "Anna2 Test" },
                        "email": { "type": "string", "example": "anna2.test@example.com" },
                        "_id": { "type": "string", "example": "6873aebc8c71dc460b5d365e" },
                        "createdAt": { "type": "string", "example": "2025-07-13T13:03:56.324Z" },
                        "updatedAt": { "type": "string", "example": "2025-07-13T13:03:56.324Z" },
                        "__v": { "type": "integer", "example": 0 }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid input",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Missing required fields" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "User login",
        "operationId": "loginUser",
        "description": "Login user with email and password.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UserInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User logged in successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "success" },
                    "message": { "type": "string", "example": "Successfully logged in an user!" },
                    "data": {
                      "type": "object",
                      "properties": {
                        "accessToken": { "type": "string", "example": "jwt-token" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid email or password",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string", "example": "error" },
                    "message": { "type": "string", "example": "Invalid email or password" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Contact": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "6873b7b1957d23253b9e6537" },
          "name": { "type": "string", "example": "Anna Smith" },
          "phoneNumber": { "type": "string", "example": "+380991112233" },
          "email": { "type": "string", "example": "anna.smith@work.com" },
          "isFavourite": { "type": "boolean", "example": false },
          "contactType": { "type": "string", "example": "work" },
          "userId": { "type": "string", "example": "6873aebc8c71dc460b5d365e" },
          "photo": { "type": ["string", "null"], "example": null },
          "createdAt": { "type": "string", "example": "2025-07-13T13:42:09.531Z" },
          "updatedAt": { "type": "string", "example": "2025-07-13T13:42:09.531Z" }
        }
      },
      "ContactInput": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Anna Smith" },
          "phoneNumber": { "type": "string", "example": "+380991112233" },
          "email": { "type": "string", "example": "anna.smith@work.com" },
          "isFavourite": { "type": "boolean", "example": false },
          "contactType": { "type": "string", "example": "work" }
        },
        "required": ["name", "phoneNumber", "email", "contactType"]
      },
      "NotFound": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "example": "error" },
          "message": { "type": "string", "example": "Contact not found" }
        }
      },
      "UserInput": {
        "type": "object",
        "properties": {
          "email": { "type": "string", "example": "jane@mail.com" },
          "password": { "type": "string", "example": "secretPassword" }
        },
        "required": ["email", "password"]
      },
      "UserInputWithName": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "example": "Jane Doe" },
          "email": { "type": "string", "example": "jane@mail.com" },
          "password": { "type": "string", "example": "secretPassword" }
        },
        "required": ["name", "email", "password"]
      },
      "User": {
        "type": "object",
        "properties": {
          "_id": { "type": "string", "example": "64cde2b1a3bbd14d9b2c5ad2" },
          "email": { "type": "string", "example": "jane@mail.com" }
        },
        "required": ["_id", "email"]
      }
    }
  }
}
